MIN_WEIGHT_DELTA = 0.0075

MIN_CASH_BUFFER = 1_000.0
MIN_CASH_BUFFER_PCT = 0.01
DEFAULT_CASH_BUFFER_PCT = 0.08

MAX_GROSS_EXPOSURE = 0.92
MAX_POSITION_WEIGHT = 0.18
