MAX_ORDER_DOLLARS = 15_000.0
MAX_SINGLE_ORDER_QTY = 10_000

DAILY_DRAWDOWN_LIMIT = -0.025
KILL_SWITCH_EQUITY_FLOOR = 95_000.0

MAX_DAILY_LOSS_PCT = 0.02
MAX_DAILY_LOSS_DOLLARS = 2_000.0

HEARTBEAT_SECONDS = 60


