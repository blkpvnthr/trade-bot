# ── TradingView futures/index regime layer (tradingview_market_context.py) ─────────
# Regime engine + options-exposure throttle + VIX/VX gate + OPRA contract filter.
TRADINGVIEW_CONTEXT_ENABLED=true       # master switch for the regime engine
TRADINGVIEW_FUTURES_FEED_ENABLED=true  # enhance with real ES/NQ futures + VX term structure (best-effort)
TRADINGVIEW_OPTIONS_FEED_ENABLED=true  # apply the OPRA-aware long-call contract filter
REGIME_THROTTLE_ENABLED=true           # scale options sizing by the regime (STRONG=1.0..PANIC=0)
REGIME_CONTEXT_TTL_SEC=300             # regime cache TTL (protects the data feed)

# ── Dashboard data freshness ───────────────────────────────────────────────────────
ACCOUNT_STATS_LOG_SEC=60               # how often the bot writes the dashboard snapshot (lower = fresher)

# ── Dashboard sign-in (dash_auth.py): Google + GitHub OAuth + email/password ───────
DASH_ALLOWED_EMAILS=contact@quantumquant.trade   # only these emails may sign in (comma-sep)
DASH_USERS=                                        # email:hash,...  (scripts/hash_password.py)
GOOGLE_CLIENT_ID=                                  # Google Cloud → OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=                                  # GitHub → Settings → Developer settings → OAuth App
GITHUB_CLIENT_SECRET=
DASH_BASE_URL=https://tv.quantumquant.trade   # deterministic OAuth redirect base
# Redirect URIs to register: https://tv.quantumquant.trade/dash/auth/{google,github}/callback

# ── News source (Alpaca news + local FinBERT replaces Alpha Vantage NEWS_SENTIMENT) ──
NEWS_SOURCE=av                  # av (default) | alpaca — alpaca uses Alpaca news + FinBERT, same row schema
FINBERT_ENABLED=0               # 1 to score sentiment locally; needs `python bootstrap_finbert.py --download` first
FINBERT_MODEL_DIR=models/nlp/finbert   # local model cache (gitignored; ~440MB)
NEWS_STREAM_SYMBOLS=            # empty = stream the locked universe; "*" = ALL news (firehose)
# ⚠ Do NOT set RL_NEWS_FEATURES=1 with NEWS_SOURCE=alpaca until RL agents are retrained on Alpaca-sourced features.

# ── Trend Join Long (TJL) engine (tjl_signal.py) ──────────────────────────────
# Deterministic long-only momentum-into-trend strategy ported 1:1 from the Pine v6
# "Trend Join Long (TJL)". Entries route through the same risk-gated broker as every
# other engine (allow_momentum=True so the dip-buy 9-EMA gate doesn't kill the
# crossover entry; regime + below-200SMA blocks still apply). OFF by default.
TJL_ENABLED=false               # master switch (default off — validate in paper first)
TJL_TREND_TF=60m                # long-term trend timeframe
TJL_TREND_SMA_LEN=200           # trend SMA length (price>SMA on last completed bar = uptrend)
TJL_MOMO_TF=15m                 # medium-term momentum timeframe
TJL_STOCH_LEN=14                # stochastic length
TJL_SMOOTH_K=3                  # stoch %K smoothing
TJL_SMOOTH_D=3                  # stoch %D smoothing
TJL_STOCH_OB=80                 # block entries when K >= this (overbought)
TJL_FAST_EMA=9                  # entry fast EMA
TJL_SLOW_EMA=21                 # entry slow EMA
TJL_STOP_PCT=0.015              # stop-loss fraction (1.5% below avg entry)
TJL_TP_PCT=0.03                 # take-profit fraction (3.0% above avg entry)
TJL_EOD_FLAT=true               # flatten any open TJL position at session end
