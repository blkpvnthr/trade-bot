# ── TradingView futures/index regime layer (tradingview_market_context.py) ─────────
# Regime engine + options-exposure throttle + VIX/VX gate + OPRA contract filter.
TRADINGVIEW_CONTEXT_ENABLED=true       # master switch for the regime engine
TRADINGVIEW_FUTURES_FEED_ENABLED=true  # enhance with real ES/NQ futures + VX term structure (best-effort)
TRADINGVIEW_OPTIONS_FEED_ENABLED=true  # apply the OPRA-aware long-call contract filter
REGIME_THROTTLE_ENABLED=true           # scale options sizing by the regime (STRONG=1.0..PANIC=0)
REGIME_CONTEXT_TTL_SEC=300             # regime cache TTL (protects the data feed)

# ── Dashboard data freshness ───────────────────────────────────────────────────────
ACCOUNT_STATS_LOG_SEC=60               # how often the bot writes the dashboard snapshot (lower = fresher)
