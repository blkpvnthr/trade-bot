# .env.bot01.example — tux_mtf_original (conservative multi-timeframe)
# Copy to .env.bot01 and replace REPLACE_ME values before running.
# NEVER commit .env.bot01 — it is git-ignored.
APCA_API_KEY_ID=REPLACE_ME
APCA_API_SECRET_KEY=REPLACE_ME
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_PAPER=true
PAPER_ONLY=true
ALLOW_LIVE_TRADING=
STRATEGY_ID=tux_mtf_original
CONFIG_PATH=configs/strategy_experiments.yaml
ALPACA_REGULAR_FEED=iex
LOG_DIR=logs/execution/tux_mtf_original
