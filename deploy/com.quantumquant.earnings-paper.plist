<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.quantumquant.earnings-paper</string>

  <!-- Daily earnings_within_7d paper run: fetch forward calendar -> paper (real Alpaca paper
       broker) -> reconcile. Pre-open at 09:00 local (system TZ = America/New_York), Mon-Fri.
       Live trading is impossible; the broker is paper-only and fail-closes without PK keys. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/blkpvnthr/Desktop/trader/run_earnings_paper.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/blkpvnthr/Desktop/trader</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>EARNINGS_PAPER_BROKER</key>
    <string>alpaca</string>
    <key>PATH</key>
    <string>/Users/blkpvnthr/Desktop/trader/.venv/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Weekdays Mon(1)..Fri(5) at 09:00 ET (pre-open). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/blkpvnthr/Desktop/trader/logs-local/earnings_paper.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/blkpvnthr/Desktop/trader/logs-local/earnings_paper.err</string>
</dict>
</plist>
