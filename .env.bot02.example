# .env.bot02.example — pivot_points (floor-trader pivot bounce/breakout)
# Copy to .env.bot02 and replace REPLACE_ME values before running.
# NEVER commit .env.bot02 — it is git-ignored.
APCA_API_KEY_ID=REPLACE_ME
APCA_API_SECRET_KEY=REPLACE_ME
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_PAPER=true
PAPER_ONLY=true
ALLOW_LIVE_TRADING=
STRATEGY_ID=pivot_points
CONFIG_PATH=configs/strategy_experiments.yaml
ALPACA_REGULAR_FEED=iex
LOG_DIR=logs/execution/pivot_points
