# .env.bot03.example — liquidity_sweep (smart money sweep reversal)
# Copy to .env.bot03 and replace REPLACE_ME values before running.
# NEVER commit .env.bot03 — it is git-ignored.
APCA_API_KEY_ID=REPLACE_ME
APCA_API_SECRET_KEY=REPLACE_ME
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_PAPER=true
PAPER_ONLY=true
ALLOW_LIVE_TRADING=
STRATEGY_ID=liquidity_sweep
CONFIG_PATH=configs/strategy_experiments.yaml
ALPACA_REGULAR_FEED=iex
LOG_DIR=logs/execution/liquidity_sweep
