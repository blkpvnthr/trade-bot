# .env.bot04.example — webhook_order_router
# Copy to .env.bot04 and replace REPLACE_ME values before running.
# NEVER commit .env.bot04 — it is git-ignored.
APCA_API_KEY_ID=REPLACE_ME
APCA_API_SECRET_KEY=REPLACE_ME
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_PAPER=true
PAPER_ONLY=true
ALLOW_LIVE_TRADING=
INSTANCE_NAME=webhook_order_router
INSTANCE_ROLE=webhook_order_router
STRATEGY_ID=webhook_order_router
LOG_DIR=logs/execution/webhook_order_router

# Queue and routing config
CONSUME_WEBHOOK_ORDER_QUEUE=true
WEBHOOK_EXECUTE_ORDERS=1
WEBHOOK_DIRECT_ORDER_ROUTING=false
REQUIRE_OPPORTUNITY_FINDER_APPROVAL=true
REQUIRE_FOOTPRINT_CONFIRMATION_FOR_BUYS=true
WEBHOOK_ROUTER_SCAN_SECONDS=5
WEBHOOK_MAX_ORDER_DOLLARS=3000
WEBHOOK_MIN_ORDER_DOLLARS=50
WEBHOOK_DAILY_LOSS_LIMIT_DOLLARS=500
WEBHOOK_DAILY_LOSS_LIMIT_PCT=0.02

# Scalping layer (disabled on webhook router instance)
SCALP_LAYER_ENABLED=0

# Run strategy/scanner loops off — this instance only routes webhook signals
RUN_STRATEGY_LOOP=false
RUN_SCANNER_LOOP=false
