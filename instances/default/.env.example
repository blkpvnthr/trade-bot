# instances/default/.env.example
# Default instance — copy to .env and fill in your values.
# This is the shared baseline used when INSTANCE is not set.

# ── Alpaca credentials ───────────────────────────────────────────────────────
APCA_API_KEY_ID=your_paper_api_key
APCA_API_SECRET_KEY=your_paper_api_secret
APCA_PAPER=true

# ── Data feeds ───────────────────────────────────────────────────────────────
ALPACA_PREMARKET_FEED=sip
ALPACA_REGULAR_FEED=iex
ALPACA_FAIL_ON_FEED_ERROR=0
ALLOW_YFINANCE_MARKET_DATA_FALLBACK=0
ALPACA_CHUNK_SIZE=25
RL_INTRADAY_LOOKBACK_DAYS=30

# ── Strategy toggles ─────────────────────────────────────────────────────────
USE_TRADINGVIEW_SCREENER=1
TRADINGVIEW_REQUIRE_RVOL=1.2
TRADINGVIEW_MAX_PLANNER_SYMBOLS=20
OPTIONS_BOOSTER_ENABLED=1
PREMARKET_DATA_COLLECTOR_ENABLED=1
RL_SHADOW_MODE=1
SELF_OPTIMIZATION_ENABLED=0
STREAM_CONFIRMED_MOVEMENT_ENABLED=1

# ── Risk limits ──────────────────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.015
MAX_DAILY_LOSS_DOLLARS=2000
KILL_SWITCH_EQUITY_FLOOR=95000
MIN_CASH_BUFFER=1500
MAX_GROSS_EXPOSURE=0.72
MAX_ORDER_DOLLARS=1500

# ── Safe mode ────────────────────────────────────────────────────────────────
SAFE_MODE_ON_PLANNER_FAILURE=1
MAX_PLAN_AGE_MINUTES=15
BEARISH_MARKET_DISABLE_NEW_LONGS=1

# ── Ports (set if running webhook or dashboard) ──────────────────────────────
WEBHOOK_PORT=5000
DASHBOARD_PORT=8050
TRADINGVIEW_WEBHOOK_SECRET=your_webhook_secret

# ── Logging and output paths ─────────────────────────────────────────────────
# LOG_DIR=logs/execution
# DATA_DIR=system-data

# ── ML / RL ──────────────────────────────────────────────────────────────────
# RUN_DATA_DATE=YYYYMMDD
# RL_DATA_DATE=YYYYMMDD
FORECAST_ENGINE_MODEL_DIR=models/forecast

# ── OpenAI (used by llm_sentiment_universe_selector) ─────────────────────────
OPENAI_API_KEY=your_openai_key
