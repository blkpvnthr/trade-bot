# instances/pivot_engine/.env.example
# Pivot Engine instance — focused on pivot breakout/reclaim strategies.
# Run with: INSTANCE=pivot_engine python run.py

# ── Alpaca paper credentials ─────────────────────────────────────────────────
APCA_API_KEY_ID=your_paper_api_key
APCA_API_SECRET_KEY=your_paper_api_secret
APCA_PAPER=true

# ── Data feeds ───────────────────────────────────────────────────────────────
ALPACA_PREMARKET_FEED=sip
ALPACA_REGULAR_FEED=iex
ALPACA_FAIL_ON_FEED_ERROR=0
ALLOW_YFINANCE_MARKET_DATA_FALLBACK=0

# ── Strategy (pivot-focused) ─────────────────────────────────────────────────
USE_TRADINGVIEW_SCREENER=1
TRADINGVIEW_MAX_PLANNER_SYMBOLS=15
OPTIONS_BOOSTER_ENABLED=0
PREMARKET_DATA_COLLECTOR_ENABLED=1
RL_SHADOW_MODE=1
SELF_OPTIMIZATION_ENABLED=0
STREAM_CONFIRMED_MOVEMENT_ENABLED=1

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.015
MAX_DAILY_LOSS_DOLLARS=2000
KILL_SWITCH_EQUITY_FLOOR=95000
MIN_CASH_BUFFER=1500
MAX_GROSS_EXPOSURE=0.72
MAX_ORDER_DOLLARS=1200

# ── Pivot-specific ────────────────────────────────────────────────────────────
# STRATEGY_ID=pivot_engine

# ── Ports ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=5002

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_DIR=logs/execution/pivot_engine
