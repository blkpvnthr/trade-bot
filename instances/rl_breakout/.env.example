# instances/rl_breakout/.env.example
# RL Breakout instance — dedicated to RL training and breakout strategy research.
# Run with: INSTANCE=rl_breakout python run.py
#          or: INSTANCE=rl_breakout python rl_spx_breakout_trainer.py

# ── Alpaca paper credentials ─────────────────────────────────────────────────
APCA_API_KEY_ID=your_paper_api_key
APCA_API_SECRET_KEY=your_paper_api_secret
APCA_PAPER=true

# ── Data feeds ───────────────────────────────────────────────────────────────
ALPACA_PREMARKET_FEED=sip
ALPACA_REGULAR_FEED=iex
ALPACA_FAIL_ON_FEED_ERROR=0
ALLOW_YFINANCE_MARKET_DATA_FALLBACK=0
RL_INTRADAY_LOOKBACK_DAYS=60

# ── Strategy (RL-focused) ─────────────────────────────────────────────────────
USE_TRADINGVIEW_SCREENER=0
OPTIONS_BOOSTER_ENABLED=0
PREMARKET_DATA_COLLECTOR_ENABLED=1
RL_SHADOW_MODE=0
SELF_OPTIMIZATION_ENABLED=0

# ── Risk limits (conservative during training) ────────────────────────────────
MAX_DAILY_LOSS_PCT=0.010
MAX_DAILY_LOSS_DOLLARS=1500
KILL_SWITCH_EQUITY_FLOOR=11700
MIN_CASH_BUFFER=1500
MAX_GROSS_EXPOSURE=0.60
MAX_ORDER_DOLLARS=1000

# ── RL training settings ──────────────────────────────────────────────────────
# RL_DATA_DATE=YYYYMMDD
FORECAST_ENGINE_MODEL_DIR=models/forecast/rl_breakout

# ── Ports ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=5003

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_DIR=logs/execution/rl_breakout
