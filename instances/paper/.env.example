# instances/paper/.env.example
# Paper trading instance — safe for development and strategy testing.
# Run with: INSTANCE=paper python run.py

# ── Alpaca paper credentials ─────────────────────────────────────────────────
APCA_API_KEY_ID=your_paper_api_key
APCA_API_SECRET_KEY=your_paper_api_secret
APCA_PAPER=true
PAPER_ONLY=true

# ── Data feeds ───────────────────────────────────────────────────────────────
ALPACA_PREMARKET_FEED=sip
ALPACA_REGULAR_FEED=iex
ALPACA_FAIL_ON_FEED_ERROR=0
ALLOW_YFINANCE_MARKET_DATA_FALLBACK=0

# ── Strategy (paper — all features on) ───────────────────────────────────────
USE_TRADINGVIEW_SCREENER=1
OPTIONS_BOOSTER_ENABLED=1
PREMARKET_DATA_COLLECTOR_ENABLED=1
RL_SHADOW_MODE=0
SELF_OPTIMIZATION_ENABLED=0

# ── Risk limits (paper — standard) ───────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.015
MAX_DAILY_LOSS_DOLLARS=1500
KILL_SWITCH_EQUITY_FLOOR=95000
MIN_CASH_BUFFER=8000
MAX_GROSS_EXPOSURE=0.70
MAX_POSITION_WEIGHT=0.12
MAX_ORDER_DOLLARS=12000

# ── Daily-income paper objective (optimization target, never a guarantee) ────
DAILY_INCOME_CONTROLS_ENABLED=1
DAILY_PROFIT_TARGET_DOLLARS=400
DAILY_INCOME_RISK_PER_TRADE_PCT=0.0035
DAILY_INCOME_MIN_RISK_REWARD=1.5
DAILY_INCOME_MAX_OPEN_POSITIONS=5
DAILY_INCOME_MIN_PRICE=5
DAILY_INCOME_MIN_AVG_VOLUME=1000000
DAILY_INCOME_MIN_REL_VOLUME=1.5
DAILY_INCOME_USE_BRACKET_ORDERS=1
DAILY_INCOME_FLATTEN_BEFORE_CLOSE=1
DAILY_INCOME_FLATTEN_START_ET=15:45

# ── Ports ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=5000

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_DIR=logs/execution/paper
