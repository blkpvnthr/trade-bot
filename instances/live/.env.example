# instances/live/.env.example
# LIVE TRADING INSTANCE — uses real money. All risk limits enforced.
# Run with: INSTANCE=live python run.py
#
# WARNING: Set APCA_PAPER=false only when you intend to execute real orders.
#          Ensure KILL_SWITCH_EQUITY_FLOOR and MAX_DAILY_LOSS_DOLLARS are
#          appropriate for your actual account size before running.

# ── Alpaca live credentials ──────────────────────────────────────────────────
APCA_API_KEY_ID=your_live_api_key
APCA_API_SECRET_KEY=your_live_api_secret
APCA_PAPER=false

# ── Data feeds (live — prefer SIP for quality) ────────────────────────────────
ALPACA_PREMARKET_FEED=sip
ALPACA_REGULAR_FEED=sip
ALPACA_FAIL_ON_FEED_ERROR=1
ALLOW_YFINANCE_MARKET_DATA_FALLBACK=0

# ── Strategy (live — conservative) ───────────────────────────────────────────
USE_TRADINGVIEW_SCREENER=1
OPTIONS_BOOSTER_ENABLED=0
PREMARKET_DATA_COLLECTOR_ENABLED=1
RL_SHADOW_MODE=1
SELF_OPTIMIZATION_ENABLED=0

# ── Risk limits (live — tighter than paper) ───────────────────────────────────
MAX_DAILY_LOSS_PCT=0.010
MAX_DAILY_LOSS_DOLLARS=1000
KILL_SWITCH_EQUITY_FLOOR=12000
MIN_CASH_BUFFER=2000
MAX_GROSS_EXPOSURE=0.60
MAX_ORDER_DOLLARS=1000
SAFE_MODE_ON_PLANNER_FAILURE=1
MAX_PLAN_AGE_MINUTES=10
BEARISH_MARKET_DISABLE_NEW_LONGS=1

# ── Ports ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=5001

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_DIR=logs/execution/live
